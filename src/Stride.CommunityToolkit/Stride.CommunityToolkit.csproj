<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\CommonSettings.props" />

    <PropertyGroup>
        <Title>Stride Community Toolkit</Title>
        <Description>Collection of helpers and extensions for Stride Game Engine developers. Simplifies and demonstrates common developer tasks building experiences for Stride with .NET 10.$(StrideVersionNote)</Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DefineConstants>$(DefineConstants);CODE_ANALYSIS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Stride.Core" />
        <Using Include="Stride.Core.Mathematics" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Stride.Engine" Version="$(StrideVersion)" />
        <PackageReference Include="Stride.Particles" Version="$(StrideVersion)" />
        <PackageReference Include="Stride.Physics" Version="$(StrideVersion)" />
        <PackageReference Include="Stride.UI" Version="$(StrideVersion)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="*.sdpkg" Pack="true" PackagePath="stride" />
        <!-- buildTransitive so the targets are imported by direct and indirect consumers alike. -->
        <None Include="build\Stride.CommunityToolkit.targets" Pack="true" PackagePath="buildTransitive\net10.0" />
    </ItemGroup>

    <!--
        Packs the asset generator console tool under tools/net10.0, where build\Stride.CommunityToolkit.targets
        expects it. The tool is built on demand rather than through a ProjectReference so that a normal
        build of this library does not depend on it.
    -->
    <PropertyGroup>
        <StrideToolkitAssetGeneratorProject>..\Stride.CommunityToolkit.AssetGenerator\Stride.CommunityToolkit.AssetGenerator.csproj</StrideToolkitAssetGeneratorProject>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackStrideToolkitAssetGenerator</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="PackStrideToolkitAssetGenerator">
        <MSBuild Projects="$(StrideToolkitAssetGeneratorProject)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_AssetGeneratorAssembly" />
        </MSBuild>

        <ItemGroup>
            <_AssetGeneratorFile Include="%(_AssetGeneratorAssembly.RootDir)%(_AssetGeneratorAssembly.Directory)Stride.CommunityToolkit.AssetGenerator.dll" />
            <_AssetGeneratorFile Include="%(_AssetGeneratorAssembly.RootDir)%(_AssetGeneratorAssembly.Directory)Stride.CommunityToolkit.AssetGenerator.runtimeconfig.json" />
            <_AssetGeneratorFile Include="%(_AssetGeneratorAssembly.RootDir)%(_AssetGeneratorAssembly.Directory)Stride.CommunityToolkit.AssetGenerator.deps.json" />
        </ItemGroup>

        <Error Condition="'@(_AssetGeneratorFile)' == ''"
               Text="The asset generator tool was not built; the package would ship build\Stride.CommunityToolkit.targets without the tool it invokes." />

        <ItemGroup>
            <TfmSpecificPackageFile Include="@(_AssetGeneratorFile)">
                <PackagePath>tools/net10.0</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <Compile Update="Engine\EntityExtensions.GetComponents.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>EntityExtensions.GetComponents.tt</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <None Update="Engine\EntityExtensions.GetComponents.tt">
            <Generator>TextTemplatingFileGenerator</Generator>
            <LastGenOutput>EntityExtensions.GetComponents.cs</LastGenOutput>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
    </ItemGroup>

</Project>