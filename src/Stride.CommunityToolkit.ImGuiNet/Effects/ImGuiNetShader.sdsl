namespace Stride.CommunityToolkit.ImGuiNet
{
    internal shader ImGuiNetShader : ShaderBase, ColorUtility {

        matrix proj;
        stage Texture2D tex;

        // 1 when the target is linear - Stride's default, an sRGB backbuffer that re-encodes on the way
        // out. ImGui's colours are sRGB bytes, so they are decoded here or the whole UI comes out
        // washed out: the default dark theme's near-black windows measured mid-grey before this.
        stage uint LinearOutput;

        SamplerState TexSampler {
            Filter = ANISOTROPIC;
            AddressU = Wrap;
            AddressV = Wrap;
            MaxAnisotropy = 16;
        };

        stream float2 pos : POSITION;
        stream float2 uv : TEXCOORD0;
        stream float4 col : COLOR;

        override stage void VSMain() {
            streams.ShadingPosition = mul(proj, float4(streams.pos, 0.0, 1.0f)) + float4(-1.0f, 1.0f, 0.0f, 0.0f);
        }

        override stage void PSMain() {
            float4 color = LinearOutput != 0 ? ToLinear(streams.col) : streams.col;

            streams.ColorTarget = color * tex.Sample(TexSampler, streams.uv);
        }

    };
}