namespace E02_3D_Material_Gallery
{
    // A 4x4 ordered dither as a scalar input, the same table the engine's alpha-dithered shadow
    // caster uses: each pixel gets a threshold from its screen position, so a cutoff at 0.5 keeps
    // every other pixel in a fixed screen-door pattern - the classic way to fade an object without
    // sorting it.
    shader GalleryDither : ComputeColor, ShaderBase
    {
        static const float Bayer[16] = { 0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5 };

        override float4 Compute()
        {
            uint2 p = uint2(streams.ShadingPosition.xy) % 4;
            float threshold = (Bayer[p.y * 4 + p.x] + 0.5) / 16.0;

            return float4(threshold, threshold, threshold, threshold);
        }
    };
}