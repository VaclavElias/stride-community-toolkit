<Project>
  <!--
    MSBuild imports only the NEAREST Directory.Build.props, so the repository-root one must be
    imported explicitly or its settings (TargetFramework, StrideVersion, ...) would be lost here.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Host-only runtime and a lean output; shared with tests/ and tools/, explained in the file. -->
  <Import Project="$(MSBuildThisFileDirectory)../build/HostRuntime.props" />
</Project>